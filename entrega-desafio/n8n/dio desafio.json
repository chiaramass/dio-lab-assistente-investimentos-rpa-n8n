      },
      "id": "ab5f9067-76f8-4492-92f6-6974bcf93451",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        48,
        -176
      ]
    },
    {
      "parameters": {
        "jsCode": "const csv = String($input.first().json.data || '');\nconst lines = csv.split(/\\r?\\n/).filter(l => l.trim());\nconst header = lines.shift().split(',').map(h => h.trim());\nconst norm = s => String(s || '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').trim().toLowerCase();\nconst produtos = lines.map(l => {\n  const c = l.split(',');\n  const o = {};\n  header.forEach((h, i) => { o[h] = (c[i] || '').trim(); });\n  return o;\n});\nconst body = $('Webhook').first().json.body;\nconst clientes = Array.isArray(body) ? body : (body && Array.isArray(body.clientes) ? body.clientes : [body]);\nreturn clientes.map(cli => {\n  const nome = (cli && cli.nome) || 'cliente';\n  const perfil = (cli && cli.perfil) || '';\nconst saldoBruto = cli ? cli.saldo : null;\n  let saldo = null;\n  if (typeof saldoBruto === 'number') {\n    saldo = saldoBruto;\n  } else if (saldoBruto !== undefined && saldoBruto !== null && saldoBruto !== '') {\n    const n = parseFloat(String(saldoBruto).replace(/[^0-9,.-]/g, '').split('.').join('').replace(',', '.'));\n    saldo = isNaN(n) ? null : n;\n  }\n  const opcoes = produtos.filter(p => norm(p.perfil) === norm(perfil));\n  let mensagem;\n  if (opcoes.length === 0) {\n    mensagem = 'Ola, ' + nome + '! Nao encontramos opcoes de investimento para o perfil informado.';\n  } else {\n    mensagem = 'Ola, ' + nome + '! Com base no seu perfil ' + perfil + ', recomendamos: ' + opcoes.map(p => p.produto + ' (minimo R$ ' + p.minimo + ', rentabilidade ' + p.rentabilidade + ')').join('; ') + '.';\n  }\n  return { json: { nome: nome, perfil: perfil, saldo: saldo, recomendacoes: opcoes, mensagem: mensagem } };\n});"
      },
